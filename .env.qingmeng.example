# 倾梦GPT绘画企业级百万号池系统 · 环境变量示例
# 复制为 .env 后填写，不要把真实密钥提交到任何仓库。

# 必填：控制台与 API 的管理密钥（登录 Bearer key）
# 必须是 12 位以上随机串，建议 32 位；示例值会被启动校验拒绝。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
QINGMENG_AUTH_KEY=change-me-please

# 可选：对外访问地址，用于生成图片公网链接
QINGMENG_BASE_URL=

# 端口映射（宿主机端口 → 容器 80）
QINGMENG_PORT=3100

# 镜像名（如直接拉取私有仓库镜像，填完整地址）
QINGMENG_IMAGE=qingmeng/qingmeng-gpt:1.2.4

# 数据库：留空使用容器内 SQLite；百万账号建议 PostgreSQL
# DATABASE_URL=postgresql://qingmeng:qingmeng@postgres:5432/qingmeng
DATABASE_URL=

POSTGRES_USER=qingmeng
POSTGRES_PASSWORD=qingmeng
POSTGRES_DB=qingmeng

TZ=Asia/Shanghai
NPM_REGISTRY=https://registry.npmjs.org
PIP_INDEX_URL=https://pypi.org/simple
